# SnipShot Environment Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Hardware & Engine Profile
HARDWARE_PROFILE_OVERRIDE=  # Leave empty for auto-detect (tier1, tier2, tier3)
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Paths
UPLOAD_DIR=../data/uploads
CACHE_DIR=../data/cache
EXPORT_DIR=../data/exports
DB_PATH=../data/db/snipshot.db

# Optional Cloud API fallbacks (Leave blank for 100% offline local operation)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
